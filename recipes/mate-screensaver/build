cd mate-screensaver-1.28.1
./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static \
    --libexecdir=/usr/lib/mate-screensaver --without-console-kit --without-systemd --enable-locking --with-mit-ext
make
make DESTDIR="$DESTDIR" install
install -Dm644 ../mate-screensaver.pam "$DESTDIR/etc/pam.d/mate-screensaver"
