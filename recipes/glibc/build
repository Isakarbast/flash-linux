cd glibc-2.44
patch -Np1 -i ../glibc-fhs-1.patch
patch -Np1 -i ../glibc-2.44-upstream_fixes-3.patch
mkdir build
cd build
echo "rootsbindir=/usr/sbin" > configparms
../configure --prefix=/usr \
    --disable-werror \
    --disable-nscd \
    libc_cv_slibdir=/usr/lib \
    --enable-stack-protector=strong \
    --enable-kernel=5.10
make
sed '/test-installation/s@$(PERL)@echo not running@' -i ../Makefile

mkdir -p "$DESTDIR/etc/ld.so.conf.d"
cat > "$DESTDIR/etc/ld.so.conf" <<'EOF'
/usr/local/lib
include /etc/ld.so.conf.d/*.conf
EOF
make DESTDIR="$DESTDIR" install
sed '/RTLDLIST=/s@/usr@@g' -i "$DESTDIR/usr/bin/ldd"
rm -f "$DESTDIR/etc/ld.so.cache"

cat > "$DESTDIR/etc/nsswitch.conf" <<'EOF'
passwd: files
group: files
shadow: files

hosts: files dns
networks: files

protocols: files
services: files
ethers: files
rpc: files
EOF

install -Dm755 ../../locale-gen "$DESTDIR/usr/bin/locale-gen"
install -Dm644 ../../locale.gen "$DESTDIR/etc/locale.gen"
install -Dm644 ../../ldconfig.hook "$DESTDIR/usr/share/fpm/hooks/ldconfig.hook"
