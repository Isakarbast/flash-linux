cd steam-launcher
make DESTDIR="$DESTDIR" install-bin install-docs install-icons install-bootstrap \
    install-desktop install-appdata
# steamdeps installs missing libraries with apt; here fpm does that.
ln -sf true "$DESTDIR/usr/bin/steamdeps"
rm -f "$DESTDIR/usr/lib/steam/bin_steamdeps.py"

# Controller and VR headset access. eudev has no "uaccess" (systemd-logind
# applies it), so the devices also go to the input group.
cd subprojects/steam-devices
for f in 60-steam-input.rules 60-steam-vr.rules; do
    sed 's/TAG+="uaccess"/MODE="0660", GROUP="input", TAG+="uaccess"/' "$f" |
        install -Dm644 /dev/stdin "$DESTDIR/usr/lib/udev/rules.d/$f"
done
