cd libxcrypt-4.5.2
export CC="gcc -m32" CXX="g++ -m32"
export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
sed -i '/strchr/s/const//' lib/crypt-{sm3,gost}-yescrypt.c
./configure --prefix=/usr --libdir=/usr/lib32 --build=i686-pc-linux-gnu \
    --enable-hashes=strong,glibc --enable-obsolete-api=no \
    --disable-static --disable-failure-tokens
make
make DESTDIR="$DESTDIR" install
make distclean
./configure --prefix=/usr --libdir=/usr/lib32 --build=i686-pc-linux-gnu \
    --enable-hashes=strong,glibc --enable-obsolete-api=glibc \
    --disable-static --disable-failure-tokens
make
cp -a --remove-destination .libs/libcrypt.so.1* "$DESTDIR/usr/lib32"
# Keep only /usr/lib32: headers, programs and data come from the 64-bit package.
find "$DESTDIR" -mindepth 1 -maxdepth 1 ! -name usr -exec rm -rf {} +
find "$DESTDIR/usr" -mindepth 1 -maxdepth 1 ! -name lib32 -exec rm -rf {} +
