cd zxing-cpp-3.1.1
cmake -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -D CMAKE_SKIP_INSTALL_RPATH=ON -W no-author \
    -D \
    ZXING_C_API=OFF \
    -D \
    ZXING_EXAMPLES=OFF \
    -D \
    ZXING_WRITERS=BOTH
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
