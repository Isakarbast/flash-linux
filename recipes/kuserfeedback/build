cd kuserfeedback-6.29.0
cmake -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_INSTALL_LIBEXECDIR=lib \
    -D CMAKE_SKIP_INSTALL_RPATH=ON -D CMAKE_BUILD_TYPE=Release \
    -D BUILD_TESTING=OFF -D BUILD_PYTHON_BINDINGS=OFF -D BUILD_QCH=OFF -W no-author
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
rm -rf "${DESTDIR:?}/usr/lib/systemd"
