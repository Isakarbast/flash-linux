cd Waybar-0.15.0
# Tray icons get their right-click menus from libdbusmenu-gtk3, which stage 9f
# builds after Waybar (9f then rebuilds Waybar with it).
if [ -e /usr/lib/pkgconfig/dbusmenu-gtk3-0.4.pc ]; then dbusmenu=enabled; else dbusmenu=disabled; fi
meson setup build --prefix=/usr --buildtype=release \
    -Dcpp_std=c++20 -Dexperimental=true -Dlibnl=enabled -Dlibudev=enabled -Dlibevdev=enabled -Dpulseaudio=enabled \
    -Dupower_glib=enabled -Dwireplumber=enabled -Dmpris=disabled -Dmpd=disabled -Djack=disabled -Dsndio=disabled \
    -Ddbusmenu-gtk=$dbusmenu -Dsystemd=disabled -Dman-pages=disabled -Dtests=disabled -Dcava=disabled -Dniri=false -Dgps=disabled -Dlogin-proxy=false
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
