cd fastfetch-2.71.0
cmake -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -W no-dev \
    -D BUILD_FLASHFETCH=OFF -D BUILD_TESTS=OFF -D ENABLE_SYSTEM_YYJSON=OFF -D ENABLE_RPM=OFF \
    -D ENABLE_IMAGEMAGICK6=OFF -D ENABLE_IMAGEMAGICK7=OFF
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
