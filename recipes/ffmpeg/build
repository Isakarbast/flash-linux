cd ffmpeg-9.0.2
./configure --prefix=/usr \
    --enable-gpl --enable-version3 \
    --disable-static --enable-shared --disable-debug --disable-doc \
    --enable-openssl --enable-libfreetype --enable-libdav1d \
    --enable-libdrm --enable-vulkan --enable-libxcb \
    --enable-ffnvcodec --enable-nvdec --enable-nvenc --enable-cuvid
make
make DESTDIR="$DESTDIR" install
