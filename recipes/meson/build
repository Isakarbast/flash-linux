cd meson-1.12.1
export PIP_ROOT_USER_ACTION=ignore
pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
pip3 install --root="$DESTDIR" --no-index --find-links dist --no-deps --ignore-installed --no-cache-dir meson
install -Dm644 data/shell-completions/bash/meson "$DESTDIR/usr/share/bash-completion/completions/meson"
install -Dm644 data/shell-completions/zsh/_meson "$DESTDIR/usr/share/zsh/site-functions/_meson"
