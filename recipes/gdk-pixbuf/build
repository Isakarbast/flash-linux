cd gdk-pixbuf-2.44.8
meson setup build --prefix=/usr --buildtype=release \
    -Dpng=enabled -Dgif=enabled -Djpeg=enabled -Dtiff=disabled -Dthumbnailer=disabled -Dglycin=disabled -Dintrospection=enabled -Dman=false -Dtests=false --wrap-mode=nofallback
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
