cd gcr-3.41.2
# It looks up ssh-add and ssh-agent even with its SSH agent off (unused then).
sed -i "s|^ssh_add_path = find_program('ssh-add'.*|ssh_add_path = '/usr/bin/ssh-add'|; s|^ssh_agent_path = find_program('ssh-agent'.*|ssh_agent_path = '/usr/bin/ssh-agent'|" meson.build
meson setup build --prefix=/usr --buildtype=release \
    -Dssh_agent=false -Dsystemd=disabled -Dgtk_doc=false -Dintrospection=true -Dgtk=true -Dgpg_path=/usr/bin/gpg
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
