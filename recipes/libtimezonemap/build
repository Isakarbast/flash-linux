cd libtimezonemap-0.4.6
# Debian's patches: libsoup 3, a use-after-free fix, and the UI file path.
for p in port-to-libsoup3 timezone-map-Never-try-to-access-to-free-d-or-null-values tz-Include-UI-files-from-installed-path; do
    patch -Np1 -i "../$p.patch"
done
# Privacy: the city search box would send what is typed to Ubuntu's geoname
# server. Cinnamon only uses the map; the search stays offline.
sed -i '/^request_zones (/,/queued_request = 0;/ s|queued_request = 0;|&\n  return FALSE; /* Flash Linux: no online lookup */|' src/timezone-completion.c
grep -q 'Flash Linux: no online lookup' src/timezone-completion.c
autoreconf -fi
./configure --prefix=/usr --disable-static --enable-introspection
make
make DESTDIR="$DESTDIR" install
