cd libxcrypt-4.5.2
sed -i '/strchr/s/const//' lib/crypt-{sm3,gost}-yescrypt.c
./configure --prefix=/usr \
    --enable-hashes=strong,glibc \
    --enable-obsolete-api=no \
    --disable-static \
    --disable-failure-tokens
make
make DESTDIR="$DESTDIR" install
# Binary compatibility with programs linked against the old libcrypt.so.1.
make distclean
./configure --prefix=/usr \
    --enable-hashes=strong,glibc \
    --enable-obsolete-api=glibc \
    --disable-static \
    --disable-failure-tokens
make
cp -a --remove-destination .libs/libcrypt.so.1* "$DESTDIR/usr/lib"
