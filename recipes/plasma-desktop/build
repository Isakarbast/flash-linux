cd plasma-desktop-6.7.4
# Flash Linux: the lightning logo (from flash-branding) as the launcher's icon.
sed -i 's|<default>start-here-kde-symbolic</default>|<default>flashlinux</default>|' applets/kickoff/main.xml
cmake -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_INSTALL_LIBEXECDIR=lib \
    -D CMAKE_SKIP_INSTALL_RPATH=ON -D CMAKE_BUILD_TYPE=Release \
    -D BUILD_QT5=OFF -D BUILD_TESTING=OFF -W no-author \
    -D BUILD_KCM_MOUSE_X11=OFF -D BUILD_KCM_TOUCHPAD_X11=OFF
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
cd build
rm -rf "${DESTDIR:?}/usr/lib/systemd" "${DESTDIR:?}/usr/lib/sysusers.d" "${DESTDIR:?}/usr/lib/tmpfiles.d"
