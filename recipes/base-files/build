install -Dm644 os-release "$DESTDIR/usr/lib/os-release"
mkdir -p "$DESTDIR/etc"
ln -s ../usr/lib/os-release "$DESTDIR/etc/os-release"
install -Dm644 issue       "$DESTDIR/etc/issue"
install -Dm644 profile     "$DESTDIR/etc/profile"
install -Dm644 locale.sh   "$DESTDIR/etc/profile.d/locale.sh"
install -Dm644 shells      "$DESTDIR/etc/shells"
install -Dm644 locale.conf "$DESTDIR/etc/locale.conf"
install -Dm644 hostname    "$DESTDIR/etc/hostname"
install -Dm644 bashrc       "$DESTDIR/etc/skel/.bashrc"
install -Dm644 bash_profile "$DESTDIR/etc/skel/.bash_profile"
