cd json-glib-1.10.8
# Introspection data needs GLib's (stage 9f builds it, then rebuilds this).
if [ -e /usr/share/gir-1.0/GObject-2.0.gir ]; then gi=enabled; else gi=disabled; fi
meson setup build --prefix=/usr --buildtype=release \
    -Dintrospection=$gi -Dtests=false -Dman=false -Ddocumentation=disabled
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
