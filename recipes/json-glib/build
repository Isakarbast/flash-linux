cd json-glib-1.10.8
# Introspection data needs GLib's and the scanner (stage 9f installs both, then rebuilds this).
if command -v g-ir-scanner >/dev/null && [ -e /usr/share/gir-1.0/GObject-2.0.gir ]; then gi=enabled; else gi=disabled; fi
meson setup build --prefix=/usr --buildtype=release \
    -Dintrospection=$gi -Dtests=false -Dman=false -Ddocumentation=disabled
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
