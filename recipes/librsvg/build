# Offline crates.io: the crates from Cargo.lock (sources crate-*.crate).
mkdir vendor
for f in crate-*.crate; do
    n=${f#crate-}
    n=${n%.crate}
    mkdir "vendor/$n"
    tar --no-same-owner -xzf "$f" -C "vendor/$n" --strip-components=1
    printf '{"files":{},"package":"%s"}' "$(sha256sum "$f" | cut -d' ' -f1)" > "vendor/$n/.cargo-checksum.json"
done
export CARGO_HOME="$PWD/cargo-home"
mkdir -p "$CARGO_HOME"
cat > "$CARGO_HOME/config.toml" <<EOF2
[source.crates-io]
replace-with = "vendored"
[source.vendored]
directory = "$PWD/vendor"
[net]
offline = true
EOF2
cd librsvg-2.63.4
meson setup build --prefix=/usr --buildtype=release \
    -Dintrospection=disabled -Dvala=disabled -Ddocs=disabled -Dtests=false -Davif=disabled \
    -Dpixbuf=enabled -Dpixbuf-loader=enabled -Drsvg-convert=enabled
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
