cd abseil-cpp-20260817.0
cmake -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBEXECDIR=lib -W no-dev \
    -D BUILD_SHARED_LIBS=ON -D CMAKE_CXX_STANDARD=17 -D ABSL_PROPAGATE_CXX_STD=ON -D ABSL_BUILD_TESTING=OFF
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
