cd gsettings-desktop-schemas-51.0
# Introspection data needs GLib's and the scanner (stage 9f installs both, then rebuilds this).
if command -v g-ir-scanner >/dev/null && [ -e /usr/share/gir-1.0/GObject-2.0.gir ]; then gi=true; else gi=false; fi
meson setup build --prefix=/usr --buildtype=release \
    -Dintrospection=$gi
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
