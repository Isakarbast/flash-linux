cd glib-2.90.1
meson setup build --prefix=/usr --buildtype=release \
    -Dintrospection=disabled \
    -Dglib_debug=disabled \
    -Dman-pages=disabled \
    -Dsysprof=disabled \
    -Dtests=false
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
install -Dm644 -t "$DESTDIR/usr/share/fpm/hooks" ../glib-schemas.hook ../gio-modules.hook
