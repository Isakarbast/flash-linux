#!/sbin/openrc-run
# The D-Bus system bus (enable with: rc-update add dbus default)

description="D-Bus system message bus"
supervisor=supervise-daemon
command=/usr/bin/dbus-daemon
command_args="--system --nofork --nopidfile"

depend() {
	need localmount
	after bootmisc
	use logger
}

start_pre() {
	checkpath -d -m 0755 -o messagebus:messagebus /run/dbus
	dbus-uuidgen --ensure
}
