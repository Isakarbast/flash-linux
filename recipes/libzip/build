cd libzip-1.11.4
cmake -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_LIBEXECDIR=lib -W no-dev \
    -D ENABLE_GNUTLS=OFF -D ENABLE_MBEDTLS=OFF -D BUILD_TOOLS=ON -D BUILD_REGRESS=OFF -D BUILD_OSSFUZZ=OFF -D BUILD_EXAMPLES=OFF -D BUILD_DOC=OFF
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
