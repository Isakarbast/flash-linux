[ "${ROOT:-/}" = / ] || exit 0
install -d /etc/xml
[ -e /etc/xml/catalog ] || xmlcatalog --noout --create /etc/xml/catalog
for uri in http://cdn.docbook.org/release/xsl-nons/1.79.2 https://cdn.docbook.org/release/xsl-nons/1.79.2 \
           http://cdn.docbook.org/release/xsl-nons/current https://cdn.docbook.org/release/xsl-nons/current \
           http://docbook.sourceforge.net/release/xsl/current; do
    for rewrite in System URI; do
        xmlcatalog --noout --add "rewrite$rewrite" "$uri" \
            /usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2 /etc/xml/catalog
    done
done
