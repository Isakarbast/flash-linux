cd sudo-1.9.17p2
./configure --prefix=/usr \
    --libexecdir=/usr/lib \
    --with-secure-path \
    --with-env-editor \
    --disable-openssl \
    --docdir=/usr/share/doc/sudo-1.9.17p2 \
    --with-passprompt="[sudo] password for %p: "
make
make DESTDIR="$DESTDIR" install
install -dm750 "$DESTDIR/etc/sudoers.d"
echo '%wheel ALL=(ALL:ALL) ALL' > "$DESTDIR/etc/sudoers.d/wheel"
chmod 440 "$DESTDIR/etc/sudoers.d/wheel"
# /run is emptied at boot; sudo creates its directory there itself.
rm -rf "${DESTDIR:?}/run"
install -Dm644 ../sudo.pam "$DESTDIR/etc/pam.d/sudo"
