cd shadow-4.20.3
find man -name Makefile.in -exec sed -i 's/getspnam\.3 / /' {} \;
find man -name Makefile.in -exec sed -i 's/passwd\.5 / /'   {} \;
sed -e 's:#ENCRYPT_METHOD SHA512:ENCRYPT_METHOD YESCRYPT:' \
    -e 's:/var/spool/mail:/var/mail:' \
    -e '/PATH=/{s@/sbin:@@;s@/bin:@@}' \
    -i etc/login.defs
[ -e /usr/bin/passwd ] || touch /usr/bin/passwd
./configure --sysconfdir=/etc \
    --disable-static \
    --with-bcrypt --with-yescrypt \
    --with-libpam \
    --without-libbsd \
    --disable-logind \
    --with-group-name-max-length=32
make
make exec_prefix=/usr pamddir= DESTDIR="$DESTDIR" install
make -C man DESTDIR="$DESTDIR" install-man

# With PAM, these login.defs settings are handled by PAM modules instead.
for f in FAIL_DELAY FAILLOG_ENAB LASTLOG_ENAB MAIL_CHECK_ENAB OBSCURE_CHECKS_ENAB \
         PORTTIME_CHECKS_ENAB QUOTAS_ENAB CONSOLE MOTD_FILE FTMP_FILE NOLOGINS_FILE \
         ENV_HZ PASS_MIN_LEN SU_WHEEL_ONLY PASS_CHANGE_TRIES PASS_ALWAYS_WARN \
         CHFN_AUTH ENCRYPT_METHOD ENVIRON_FILE; do
    sed -i "s/^${f}/# &/" "$DESTDIR/etc/login.defs"
done

p="$DESTDIR/etc/pam.d"
install -Dm644 ../login.pam  "$p/login"
install -Dm644 ../passwd.pam "$p/passwd"
install -Dm644 ../su.pam     "$p/su"
for prog in chpasswd newusers; do
    sed "s/@PROGRAM@/$prog/" ../chpasswd.pam > "$p/$prog"
done
for prog in chage chfn chgpasswd chsh groupadd groupdel groupmems groupmod useradd userdel usermod; do
    sed "s/@PROGRAM@/$prog/" ../admin.pam > "$p/$prog"
done
