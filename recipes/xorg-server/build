cd xorg-server-21.1.25
meson setup build --prefix=/usr --buildtype=release \
    -Dxorg=true -Dxvfb=false -Dxnest=false -Dxephyr=false -Dglamor=true -Dudev=true \
    -Dsystemd_logind=true -Dsuid_wrapper=true -Dsecure-rpc=false \
    -Dxkb_dir=/usr/share/X11/xkb -Dxkb_output_dir=/var/lib/xkb -Ddtrace=false -Dlibunwind=false \
    -Ddocs=false -Ddevel-docs=false
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
install -d -m 755 "$DESTDIR/etc/X11/xorg.conf.d"
rm -rf "${DESTDIR:?}/var/log"
# Shared with Xwayland, which installs them (Arch's xorg-server-common).
rm "$DESTDIR/usr/lib/xorg/protocol.txt" "$DESTDIR/usr/share/man/man1/Xserver.1"
