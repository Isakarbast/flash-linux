#!/bin/bash
# new-recipe: write an fpm recipe from a download link.
#
#     tools/new-recipe URL [NAME]
#     tools/new-recipe https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/2.71.0.tar.gz
#
# Downloads the source (into $SOURCE_CACHE, default ~/.cache/distro-sources),
# pins its sha256, finds the build system (meson, cmake, autotools, Cargo,
# Python, a plain Makefile) and writes recipes/NAME/recipe and build. For Rust,
# every crate in Cargo.lock becomes a pinned source, so fpm builds offline.
# It also lists the dependencies the project asks for: check them, add the
# matching recipe names to `depends`, then build with `sudo fpm build NAME`.
#
# Options: -f / --force overwrites an existing recipe. RECIPES=dir writes
# somewhere other than this repository's recipes/.
set -euo pipefail

die() { echo "new-recipe: $*" >&2; exit 1; }
note() { echo "  $*"; }

force=0
args=()
for a in "$@"; do
    case $a in
        -f|--force) force=1 ;;
        -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) args+=("$a") ;;
    esac
done
[ ${#args[@]} -ge 1 ] || die "usage: new-recipe URL [NAME]   (--help for more)"
url=${args[0]}
here=$(cd "$(dirname "$0")" && pwd)
recipes=${RECIPES:-$here/../recipes}
cache=${SOURCE_CACHE:-$HOME/.cache/distro-sources}
mkdir -p "$cache"
for t in curl tar sha256sum; do command -v $t >/dev/null || die "needs $t"; done

# --- Name, version and file name -------------------------------------------
strip_ext() { sed -E 's/\.(tar\.(gz|xz|bz2|zst|lz)|tgz|tbz2|txz|zip)$//' <<<"$1"; }
file=${url##*/}
homepage=""
if [[ $url =~ ^https://(github\.com|codeberg\.org)/([^/]+)/([^/]+)/archive/(refs/tags/)?([^/]+)$ ]]; then
    # GitHub/Codeberg tag archives are named after the tag alone ("v1.2.tar.gz").
    host=${BASH_REMATCH[1]} owner=${BASH_REMATCH[2]} repo=${BASH_REMATCH[3]}
    tag=$(strip_ext "${BASH_REMATCH[5]}")
    name=${repo,,}
    version=${tag#v}
    version=${version#"$name"-}
    ext=${file#"$tag"}
    file="$name-$version$ext"
    homepage="https://$host/$owner/$repo"
else
    base=$(strip_ext "$file")
    # "name-1.2.3" (the version starts at the last "-" before a digit)
    if [[ $base =~ ^(.+)[-_]v?([0-9][0-9A-Za-z.+~_-]*)$ ]]; then
        name=${BASH_REMATCH[1],,} version=${BASH_REMATCH[2]}
    else
        die "can't tell the version from \"$file\"; give a link to a file like name-1.2.tar.gz"
    fi
    [[ $url =~ ^https://(github\.com|codeberg\.org)/([^/]+)/([^/]+)/ ]] && homepage="https://${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
fi
[ ${#args[@]} -ge 2 ] && name=${args[1]}
version=${version//-/.}
dir="$recipes/$name"
[ -e "$dir" ] && [ $force = 0 ] && die "$dir already exists (use --force to overwrite)"

# --- Download and checksum -----------------------------------------------------
echo "==> $name $version"
src="$cache/$file"
if [ ! -s "$src" ]; then
    note "downloading $url"
    curl -fsSL --retry 3 -o "$src.part" "$url" || die "download failed"
    mv "$src.part" "$src"
fi
sum=$(sha256sum "$src" | cut -d' ' -f1)
source_line=$url
[ "$file" != "${url##*/}" ] && source_line="$file::$url"

# --- Look inside -----------------------------------------------------------------
case $file in
    *.zip) listing=$(unzip -Z1 "$src" 2>/dev/null || bsdtar -tf "$src") ;;
    *) listing=$(tar -tf "$src") ;;
esac
top=$(head -1 <<<"$listing" | cut -d/ -f1)
grep -q "^$top/" <<<"$listing" || top=""       # no top folder
has() { grep -qx "${top:+$top/}$1" <<<"$listing"; }
show() { tar -xOf "$src" "${top:+$top/}$1" 2>/dev/null; }

if has meson.build; then kind=meson
elif has CMakeLists.txt; then kind=cmake
elif has Cargo.toml; then kind=cargo
elif has configure; then kind=autotools
elif has configure.ac || has configure.in; then kind=autoreconf
elif has pyproject.toml || has setup.py; then kind=python
elif has Makefile || has makefile || has GNUmakefile; then kind=make
else kind=unknown
fi
note "build system: $kind"

# --- The build script --------------------------------------------------------
cd_line=${top:+cd $top}
case $kind in
meson) body='meson setup build --prefix=/usr --buildtype=release
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install' ;;
cmake) body='cmake -B build -G Ninja -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_BUILD_TYPE=Release -D BUILD_TESTING=OFF -W no-dev
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install' ;;
autotools) body='./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
make
make DESTDIR="$DESTDIR" install' ;;
autoreconf) body='autoreconf -fi
./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static
make
make DESTDIR="$DESTDIR" install' ;;
python) body='# Builds a wheel with the pip bundled in Python, offline; a project that
# needs a build backend (hatchling, poetry...) needs that recipe first.
PIP="python3 $(echo /usr/lib/python3*/ensurepip/_bundled/pip-*.whl)/pip"
export HOME="$PWD"
$PIP install --no-deps --no-index --no-build-isolation --no-cache-dir --disable-pip-version-check \
    --root="$DESTDIR" --prefix=/usr --ignore-installed --no-warn-script-location .' ;;
make) body='make PREFIX=/usr
make PREFIX=/usr DESTDIR="$DESTDIR" install' ;;
cargo) body='cargo install --path . --root "$DESTDIR/usr" --locked --offline
rm -f "$DESTDIR/usr/.crates.toml" "$DESTDIR/usr/.crates2.json"' ;;
*) body='# Couldn'\''t tell how this builds: look at its README / INSTALL.
false' ;;
esac

sources=("$source_line")
sums=("$sum")
vendor=""
if [ $kind = cargo ]; then
    has Cargo.lock || die "a Rust project without Cargo.lock can't be pinned (ask upstream to ship one)"
    # Every crates.io crate in Cargo.lock, downloaded and checked against the lock.
    n=0
    while read -r cname cver csum; do
        cf="crate-$cname-$cver.crate"
        curl_url="https://static.crates.io/crates/$cname/$cname-$cver.crate"
        if [ ! -s "$cache/$cf" ]; then
            curl -fsSL --retry 3 -o "$cache/$cf.part" "$curl_url" || die "download failed: $cf"
            mv "$cache/$cf.part" "$cache/$cf"
        fi
        [ "$(sha256sum "$cache/$cf" | cut -d' ' -f1)" = "$csum" ] || die "checksum mismatch: $cf"
        sources+=("$cf::$curl_url")
        sums+=("$csum")
        n=$((n + 1))
    done < <(show Cargo.lock | awk '
        /^\[\[package\]\]/ { if (n && c && s ~ /crates.io/) print n, v, c; n=v=c=s="" }
        /^name = /     { gsub(/"/, "", $3); n=$3 }
        /^version = /  { gsub(/"/, "", $3); v=$3 }
        /^source = /   { s=$3 }
        /^checksum = / { gsub(/"/, "", $3); c=$3 }
        END { if (n && c && s ~ /crates.io/) print n, v, c }')
    note "$n crates from Cargo.lock"
    vendor='# Offline crates.io: the crates from Cargo.lock (sources crate-*.crate).
mkdir vendor
for f in crate-*.crate; do
    n=${f#crate-}
    n=${n%.crate}
    mkdir "vendor/$n"
    tar --no-same-owner -xzf "$f" -C "vendor/$n" --strip-components=1
    printf '"'"'{"files":{},"package":"%s"}'"'"' "$(sha256sum "$f" | cut -d'"'"' '"'"' -f1)" > "vendor/$n/.cargo-checksum.json"
done
export CARGO_HOME="$PWD/cargo-home"
mkdir -p "$CARGO_HOME"
cat > "$CARGO_HOME/config.toml" <<EOF2
[source.crates-io]
replace-with = "vendored"
[source.vendored]
directory = "$PWD/vendor"
[net]
offline = true
EOF2
'
fi

# --- What it depends on (hints) -------------------------------------------------
# (|| true: a project with none of them is fine.)
hints=""
case $kind in
meson) hints=$(for f in $(grep -E '(^|/)meson\.build$' <<<"$listing"); do show "${f#"${top:+$top/}"}"; done |
        grep -oE "dependency\(\s*'[^']+'" | sed -E "s/dependency\(\s*'//; s/'$//" | sort -u | tr '\n' ' ' || true) ;;
cmake) hints=$(for f in $(grep -E '(^|/)CMakeLists\.txt$' <<<"$listing"); do show "${f#"${top:+$top/}"}"; done |
        grep -oiE "find_package\s*\(\s*[A-Za-z0-9_+.-]+|pkg_check_modules\s*\(\s*[A-Za-z0-9_]+(\s+(REQUIRED|QUIET|IMPORTED_TARGET))*\s+[A-Za-z0-9_+.-]+" |
        sed -E 's/^find_package\s*\(\s*//I; s/^pkg_check_modules.*\s//I' | sort -u | tr '\n' ' ' || true) ;;
autotools|autoreconf) hints=$(show configure.ac 2>/dev/null | grep -oE "PKG_CHECK_MODULES\(\[?[A-Za-z_]+\]?,\s*\[?[^]),]+|AC_CHECK_LIB\(\[?[A-Za-z0-9_+-]+" |
        sed -E 's/^PKG_CHECK_MODULES.*,\s*\[?//; s/^AC_CHECK_LIB\(\[?/lib/' | awk '{print $1}' | sort -u | tr '\n' ' ' || true) ;;
python) hints=$(show pyproject.toml 2>/dev/null | sed -n '/^dependencies/,/]/p' | grep -oE '"[A-Za-z0-9_.-]+' | tr -d '"' | sort -u | tr '\n' ' ' || true) ;;
esac

# Meson options, so you know what can be switched off.
opts=""
if [ $kind = meson ]; then
    opts=$( (show meson_options.txt; show meson.options) 2>/dev/null | grep -oE "option\(\s*'[^']+'" | sed -E "s/option\(\s*'//" | tr '\n' ' ' || true)
fi

# A description from the GitHub repository, if it is one.
desc="TODO: one line saying what it is"
if [[ $homepage =~ ^https://github\.com/([^/]+/[^/]+)$ ]]; then
    d=$(curl -fsSL -m 10 "https://api.github.com/repos/${BASH_REMATCH[1]}" 2>/dev/null | sed -n 's/^  "description": "\(.*\)",$/\1/p' | head -1 || true)
    [ -n "$d" ] && desc=$d
fi

# --- Write it -------------------------------------------------------------------
mkdir -p "$dir"
{
    echo "# Written by tools/new-recipe: check \`depends\`, then build with \`sudo fpm build $name\`."
    [ -n "$hints" ] && echo "# The project asks for: $hints"
    echo "name        = $name"
    echo "version     = $version"
    echo "release     = 1"
    echo "description = $desc"
    [ -n "$homepage" ] && echo "url         = $homepage"
    echo "depends     = glibc"
    case $kind in
        meson) echo "makedepends = meson ninja" ;;
        cmake) echo "makedepends = cmake ninja" ;;
        cargo) echo "makedepends = rust" ;;
        python) echo "makedepends = python" ;;
    esac
    echo "source      = ${sources[*]}"
    echo "sha256      = ${sums[*]}"
} > "$dir/recipe"
{
    printf '%s' "$vendor"
    if [ $kind = cargo ]; then
        [ -n "$top" ] && echo "cd $top"
    else
        [ -n "$cd_line" ] && echo "$cd_line"
    fi
    [ -n "$opts" ] && echo "# Meson options (add -D<name>=... to switch things off): $opts"
    echo "$body"
} > "$dir/build"

echo "==> wrote $dir/recipe and build"
[ -n "$hints" ] && note "it asks for: $hints"
note "next: set depends (recipe names), then: sudo fpm build $name"
